APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8002
CORS_ORIGINS=http://127.0.0.1:5173

JWT_SECRET_KEY=replace-me
JWT_EXPIRES_MINUTES=480
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_DISPLAY_NAME=Administrator

DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
BEDROCK_REGION=us-east-1
BEDROCK_DEFAULT_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_PROFILE_NAME=
BEDROCK_TIMEOUT_SECONDS=60
DATABASE_URL=postgresql+psycopg://ai_guard_user:change-me-strong-password@127.0.0.1:5432/ai_guard
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
CHAT_CONTEXT_TOKEN_BUDGET=8192
CHAT_CONTEXT_MAX_MESSAGES=100
SESSION_LIST_LIMIT=100
SESSION_DETAIL_MESSAGE_LIMIT=200
ADMIN_QUERY_LOOKBACK_DAYS=90
ADMIN_QUERY_MAX_ROWS=10000
API_KEY_ENCRYPTION_SECRET=replace-me
SCAN_PROOF_SECRET=replace-with-at-least-32-random-bytes
SCAN_PROOF_TTL_SECONDS=300
REQUIRE_SCAN_PROOF=true
SCANNER_STRICT_MODE=true
SCANNER_TOTAL_DEADLINE_MS=15000
SCANNER_EXECUTOR_WORKERS=8

LOCAL_MODEL_CACHE_DIR=./.model-cache
PRIVACY_FILTER_ENABLED=true
PRIVACY_FILTER_MODEL_PATH=./.model-cache/openai-privacy-filter
PRIVACY_FILTER_AUTO_DOWNLOAD=false
PRIVACY_FILTER_DEVICE=cpu
PRIVACY_FILTER_DECODE_MODE=viterbi
PRIVACY_FILTER_OUTPUT_MODE=typed
PRIVACY_FILTER_CONTEXT_WINDOW_LENGTH=0
PRIVACY_FILTER_TIMEOUT_MS=1500
PRIVACY_FILTER_WORKERS=2
BUSINESS_SENSITIVE_ENABLED=true
BUSINESS_SENSITIVE_PROVIDER=ollama
BUSINESS_SENSITIVE_MODEL=qwen3.5:4b
BUSINESS_SENSITIVE_OLLAMA_URL=http://127.0.0.1:11434
BUSINESS_SENSITIVE_QWEN_MODEL=deepseek-v4-flash
BUSINESS_SENSITIVE_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BUSINESS_SENSITIVE_QWEN_API_KEY=
BUSINESS_SENSITIVE_BEDROCK_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
BUSINESS_SENSITIVE_TIMEOUT_SECONDS=20
BUSINESS_SENSITIVE_TIMEOUT_MS=12000
BUSINESS_SENSITIVE_MAX_TOKENS=1024
BUSINESS_SENSITIVE_WORKERS=20
QWEN3GUARD_ENABLED=true
QWEN3GUARD_MODEL=Qwen/Qwen3Guard-Gen-0.6B
QWEN3GUARD_MODEL_PATH=
QWEN3GUARD_DEVICE=cuda
QWEN3GUARD_MAX_NEW_TOKENS=48
QWEN3GUARD_TIMEOUT_MS=1200
QWEN3GUARD_WORKERS=1

FILE_REVIEW_ENABLED=true
FILE_REVIEW_PROVIDER=ollama
FILE_REVIEW_MODEL=qwen3.5:4b
FILE_REVIEW_BEDROCK_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
FILE_REVIEW_OLLAMA_URL=http://127.0.0.1:11434
FILE_REVIEW_TIMEOUT_SECONDS=45
FILE_REVIEW_MAX_UPLOAD_MB=20
FILE_REVIEW_WORKER_MODE=embedded
FILE_REVIEW_WORKER_POLL_SECONDS=1
FILE_REVIEW_JOB_LEASE_SECONDS=1800
FILE_REVIEW_JOB_MAX_ATTEMPTS=3
FILE_REVIEW_CHUNK_WORKERS=4
FILE_REVIEW_MAX_CHUNKS=40
FILE_REVIEW_DEFAULT_STORAGE_PATH=./uploaded-documents
FILE_REVIEW_ACTIVE_STORAGE_PROFILE=windows
FILE_REVIEW_WINDOWS_STORAGE_PATH=./uploaded-documents
FILE_REVIEW_LINUX_STORAGE_PATH=/var/lib/ai-security-gateway/uploaded-documents
FILE_REVIEW_PER_USER_STORAGE_DIRS=true

# Enable only endpoint/model/MIME combinations verified with original-file tests.
# JSON shape: {"openai":{"exact-model-id":["application/pdf","image/png"]}}
# Empty by default; no implicit text fallback or file conversion.
ATTACHMENT_CAPABILITIES={}
# Local visual guardrail; select a vision-capable model after sample validation.
FILE_REVIEW_VISION_MODEL=
FILE_REVIEW_VISION_BASE_URL=http://127.0.0.1:11434
FILE_REVIEW_VISION_TIMEOUT=120
OFFICE_CONVERTER_PATH=
OFFICE_CONVERTER_TIMEOUT=120
